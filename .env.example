# Filled by: shopify app config link && shopify app env pull
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments
SHOPIFY_APP_URL=

# AVIP backend — local api/worker OR staging (see pnpm dev:staging)
AVIP_API_URL=http://localhost:3000
AVIP_INTERNAL_SIGNAL_SECRET=   # same as avip/.env and EC2 .env.staging when using staging

# Shopify OAuth sessions (sqlite, local only — not AVIP Postgres)
DATABASE_URL=file:./prisma/dev.sqlite
